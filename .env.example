# Copy this file to .env and replace only the providers you use.
# Never commit .env or paste real keys into issues, logs, or screenshots.

# OpenAI: image generation and optional prompt translation
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_TEXT=gpt-4o-mini
OPENAI_MODEL_IMAGE=gpt-image-2

# fal.ai image models
FAL_KEY=your_fal_api_key_here

# Google Gemini prompt translation
GEMINI_API_KEY=your_gemini_api_key_here

# xAI image models
XAI_API_KEY=your_xai_api_key_here

# HotAPI image models
HOTAPI_KEY=your_hotapi_api_key_here

